.PHONY: setup start latex-template sync check fmt test app benchmark latex clean tree cloc codex-task reset-generated

PYTHON := python3
BOOTSTRAP := setup_project.py
LATEX_GENERATOR := setup_latex.py

setup:
	@echo "Checking Python..."
	@$(PYTHON) --version
	@echo "Checking uv..."
	@if ! command -v uv >/dev/null 2>&1; then \
		echo "uv not found. Install it first:"; \
		echo "curl -LsSf https://astral.sh/uv/install.sh | sh"; \
		exit 1; \
	fi
	@echo "Generating $(BOOTSTRAP)..."
	@$(PYTHON) -c 'from pathlib import Path; Path("$(BOOTSTRAP)").write_text("""from __future__ import annotations\n\nimport datetime as dt\nfrom pathlib import Path\nfrom textwrap import dedent\n\nPROJECT_DIRS = [\n    \"docs/planning\", \"docs/codex_tasks\", \"docs/changelog\", \"docs/research_notes\", \"docs/meeting_notes\", \"docs/prompts\", \"docs/decisions\",\n    \"data/raw\", \"data/interim\", \"data/processed\", \"data/external\",\n    \"src\", \"src/eda\", \"src/models\", \"src/simulation\", \"src/optimisation\", \"src/app\",\n    \"outputs/reports\", \"outputs/figures\", \"outputs/tables\", \"outputs/logs\",\n    \"notebooks\", \"tests\", \"scripts\",\n    \"templates\",\n]\n\nFILES = {\n    \"pyproject.toml\": \"\"\"[project]\\nname = \\\"ra-project\\\"\\nversion = \\\"0.1.0\\\"\\ndescription = \\\"Research assistant project workspace\\\"\\nrequires-python = \\\">=3.11\\\"\\ndependencies = [\\n    \\\"polars>=1.0,<2.0\\\",\\n    \\\"fastexcel>=0.12\\\",\\n    \\\"pandas>=2.2\\\",\\n    \\\"pyarrow>=16\\\",\\n    \\\"openpyxl>=3.1\\\",\\n    \\\"xlsxwriter>=3.2\\\",\\n    \\\"matplotlib>=3.8,<4.0\\\",\\n    \\\"hvplot>=0.10\\\",\\n    \\\"holoviews>=1.19\\\",\\n    \\\"bokeh>=3.5\\\",\\n    \\\"plotly>=5.24\\\",\\n    \\\"streamlit>=1.40\\\",\\n    \\\"simpy>=4.1,<5.0\\\",\\n    \\\"gurobipy>=12.0\\\",\\n    \\\"numpy>=1.26\\\",\\n    \\\"scipy>=1.12\\\",\\n    \\\"scikit-learn>=1.5\\\",\\n    \\\"statsmodels>=0.14\\\",\\n    \\\"joblib>=1.4\\\",\\n    \\\"pydantic>=2.8\\\",\\n    \\\"python-dotenv>=1.0\\\",\\n    \\\"rich>=13.7\\\",\\n    \\\"pytest>=8.0\\\",\\n    \\\"ruff>=0.8\\\",\\n    \\\"jupyterlab>=4.2\\\",\\n    \\\"ipykernel>=6.29\\\"\\n]\\n\\n[tool.ruff]\\nline-length = 100\\ntarget-version = \\\"py311\\\"\\nexclude = [\\\".venv\\\", \\\"data\\\", \\\"outputs\\\", \\\"latex\\\"]\\n\\n[tool.ruff.lint]\\nselect = [\\\"E\\\", \\\"F\\\", \\\"I\\\", \\\"UP\\\", \\\"B\\\"]\\nignore = [\\\"E501\\\"]\\n\\n[tool.pytest.ini_options]\\ntestpaths = [\\\"tests\\\"]\\npython_files = [\\\"test_*.py\\\"]\\n\"\"\",\n    \"docs/planning/00_project_brief.md\": \"\"\"# 00 Project Brief\\n\\n## Project Name\\n\\nTBD\\n\\n## One-Sentence Purpose\\n\\nTBD\\n\\n## Decision Context\\n\\nWhat decision, research question, or managerial problem does this project support?\\n\\n## Stakeholders\\n\\n| Stakeholder | What they care about | Implication |\\n|---|---|---|\\n| TBD | TBD | TBD |\\n\\n## Deliverables\\n\\n| Deliverable | Owner | Status | Notes |\\n|---|---|---|---|\\n| TBD | TBD | Not started | TBD |\\n\\n## Evidence Standard\\n\\nSeparate observed facts, derived metrics, assumptions, model outputs, and recommendations.\\n\"\"\",\n    \"docs/planning/01_methodology_plan.md\": \"\"\"# 01 Methodology Plan\\n\\n## Research / Analysis Question\\n\\nTBD\\n\\n## Descriptive Claims\\n\\nTBD\\n\\n## Predictive Claims\\n\\nTBD\\n\\n## Causal Claims\\n\\nTBD\\n\\n## Normative / Optimisation Claims\\n\\nTBD\\n\\n## Data Sources\\n\\n| Source | File / location | Observed variables | Limitations |\\n|---|---|---|---|\\n| TBD | TBD | TBD | TBD |\\n\\n## Validation Plan\\n\\nDefine backtesting, robustness checks, sensitivity analysis, and leakage controls.\\n\"\"\",\n    \"docs/planning/02_assumptions_register.md\": \"\"\"# 02 Assumptions Register\\n\\n| ID | Assumption | Type | Source / rationale | Sensitivity required? | Status |\\n|---|---|---|---|---:|---|\\n| A001 | TBD | Data / model / operational / business | TBD | Yes | Open |\\n\"\"\",\n    \"templates/codex_task_template.md\": \"\"\"# Codex Task Template\\n\\n## Objective\\n\\nTBD\\n\\n## Context\\n\\nOnly include context required to implement the task. Do not paste the whole project background.\\n\\n## Files Codex Should Read\\n\\n- `docs/planning/00_project_brief.md`\\n- `docs/planning/01_methodology_plan.md`\\n\\n## Files Codex May Edit\\n\\n- `src/...`\\n- `tests/...`\\n- `docs/changelog/...`\\n\\n## Files Codex Must Not Edit\\n\\n- `data/raw/`\\n- `docs/planning/` unless explicitly requested\\n- `latex/` unless explicitly requested\\n\\n## Required Outputs\\n\\n| Output | Location | Acceptance condition |\\n|---|---|---|\\n| TBD | TBD | TBD |\\n\\n## Validation\\n\\n```bash\\nuv run ruff check src tests\\nuv run pytest\\n```\\n\\n## Changelog Requirement\\n\\nWrite a changelog entry under `docs/changelog/`.\\n\"\"\",\n    \"templates/changelog_template.md\": \"\"\"# Changelog Entry\\n\\n## Date\\n\\nTBD\\n\\n## Task\\n\\nTBD\\n\\n## Files Changed\\n\\n- TBD\\n\\n## Summary\\n\\nTBD\\n\\n## Tests / Checks Run\\n\\nTBD\\n\\n## Remaining Issues\\n\\nTBD\\n\"\"\",\n    \"docs/decisions/decision_log.md\": \"\"\"# Decision Log\\n\\n| Date | Decision | Alternatives considered | Rationale | Consequence |\\n|---|---|---|---|---|\\n| TBD | TBD | TBD | TBD | TBD |\\n\"\"\",\n    \"src/app/main.py\": \"\"\"import streamlit as st\\n\\nst.set_page_config(page_title=\\\"RA Project App\\\", layout=\\\"wide\\\")\\n\\nst.title(\\\"RA Project App\\\")\\nst.write(\\\"Use this app for lightweight dashboards, EDA review, or decision-support prototypes.\\\")\\n\"\"\",\n    \"tests/test_placeholder.py\": \"\"\"def test_placeholder() -> None:\\n    assert True\\n\"\"\",\n    \".gitignore\": \"\"\".venv/\\nvenv/\\n__pycache__/\\n*.pyc\\n.DS_Store\\n.env\\n\\ndata/raw/*\\n!data/raw/.gitkeep\\ndata/interim/*\\n!data/interim/.gitkeep\\ndata/processed/*\\n!data/processed/.gitkeep\\n\\noutputs/*\\n!outputs/.gitkeep\\n\\n*.aux\\n*.bbl\\n*.bcf\\n*.blg\\n*.fdb_latexmk\\n*.fls\\n*.log\\n*.out\\n*.run.xml\\n*.synctex.gz\\n*.toc\\n\"\"\",\n}\n\n\ndef write_if_missing(path: Path, content: str) -> bool:\n    if path.exists():\n        return False\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(content, encoding=\"utf-8\")\n    return True\n\n\ndef main() -> None:\n    root = Path.cwd()\n    for folder in PROJECT_DIRS:\n        (root / folder).mkdir(parents=True, exist_ok=True)\n\n    for folder in [\"data/raw\", \"data/interim\", \"data/processed\", \"data/external\", \"outputs/reports\", \"outputs/figures\", \"outputs/tables\", \"outputs/logs\"]:\n        write_if_missing(root / folder / \".gitkeep\", \"\")\n\n    written = []\n    skipped = []\n    for rel_path, content in FILES.items():\n        if write_if_missing(root / rel_path, content):\n            written.append(rel_path)\n        else:\n            skipped.append(rel_path)\n\n    today = dt.date.today().isoformat()\n    first_task = root / f\"docs/codex_tasks/{today}_001_initial_repo_check.md\"\n    if write_if_missing(first_task, FILES[\"templates/codex_task_template.md\"]):\n        written.append(str(first_task.relative_to(root)))\n\n    print(f\"Project enriched: {root}\")\n    print(f\"Files written: {len(written)}\")\n    print(f\"Files skipped: {len(skipped)}\")\n    if skipped:\n        print(\"\\\\nSkipped existing files:\")\n        for item in skipped:\n            print(f\"  - {item}\")\n\n    print(dedent(\"\"\"\n    Next:\n      1. Run: uv sync\n      2. Edit: docs/planning/00_project_brief.md\n      3. Write Codex tasks under: docs/codex_tasks/\n    \"\"\").strip())\n\n\nif __name__ == \"__main__\":\n    main()\n""", encoding="utf-8")'
	@echo "Running $(BOOTSTRAP) to create project files..."
	@$(PYTHON) $(BOOTSTRAP)
	@if [ -f $(LATEX_GENERATOR) ]; then \
		echo "Running LaTeX generator..."; \
		$(PYTHON) $(LATEX_GENERATOR); \
	else \
		echo "Skipping LaTeX generator: $(LATEX_GENERATOR) not found."; \
	fi
	@echo "Syncing uv environment..."
	@uv sync
	@echo "Setup complete."

start:
	@$(PYTHON) $(BOOTSTRAP)

latex-template:
	@if [ ! -f $(LATEX_GENERATOR) ]; then \
		echo "Missing $(LATEX_GENERATOR). Put setup_latex.py in this folder first."; \
		exit 1; \
	fi
	@$(PYTHON) $(LATEX_GENERATOR)

sync:
	uv sync

check:
	uv run ruff check src tests
	uv run pytest

fmt:
	uv run ruff format src tests
	uv run ruff check --fix src tests

test:
	uv run pytest

benchmark:
	PYTHONPATH=src LC_ALL=C LANG=C uv run python scripts/run_benchmark.py

app:
	uv run streamlit run src/app/main.py

latex:
	cd latex && latexmk -pdf main.tex

clean:
	find . -type d -name "__pycache__" -prune -exec rm -rf {} +
	find . -type f \( -name "*.aux" -o -name "*.bbl" -o -name "*.bcf" -o -name "*.blg" -o -name "*.fdb_latexmk" -o -name "*.fls" -o -name "*.log" -o -name "*.out" -o -name "*.run.xml" -o -name "*.synctex.gz" -o -name "*.toc" \) -delete

tree:
	@if ! command -v tree >/dev/null 2>&1; then \
		echo "tree is not installed. Install with: brew install tree"; \
		exit 1; \
	fi
	tree -P '*.py' -I 'venv|.venv|__pycache__|.git'

cloc:
	@if ! command -v cloc >/dev/null 2>&1; then \
		echo "cloc is not installed. Install with: brew install cloc"; \
		exit 1; \
	fi
	cloc ./ --exclude-dir=.git,venv,.venv,__pycache__

codex-task:
	@mkdir -p docs/codex_tasks
	@if [ ! -f templates/codex_task_template.md ]; then \
		echo "Missing templates/codex_task_template.md. Run make setup first."; \
		exit 1; \
	fi
	@f="docs/codex_tasks/$$(date +%Y-%m-%d_%H%M)_task.md"; \
	cp templates/codex_task_template.md "$$f"; \
	echo "Created $$f"

reset-generated:
	@echo "WARNING: This deletes generated project files but keeps Makefile, setup_latex.py, README.md, and WORKFLOW.md."
	@echo "Current folder: $$(pwd)"
	@printf "Type DELETE to continue: "; \
	read confirm; \
	if [ "$$confirm" != "DELETE" ]; then \
		echo "Aborted."; \
		exit 1; \
	fi; \
	rm -rf docs data src outputs notebooks tests scripts latex templates .venv venv pyproject.toml uv.lock .gitignore setup_project.py
	@echo "Generated project files removed."
